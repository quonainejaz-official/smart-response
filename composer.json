{
    "name": "quonain/smart-response",
    "description": "PHP response library for standardizing REST/API responses across JSON, XML, legacy contracts, and Laravel web responses.",
    "keywords": [
        "php",
        "php-library",
        "framework-agnostic",
        "api",
        "api-response",
        "rest-api",
        "response",
        "response-formatter",
        "json",
        "json-api",
        "xml",
        "http",
        "legacy-api",
        "content-negotiation",
        "composer",
        "packagist",
        "codeigniter",
        "laravel",
        "blade",
        "inertia",
        "livewire",
        "smart-response"
    ],
    "type": "library",
    "homepage": "https://github.com/quonainejaz-official/smart-response",
    "support": {
        "issues": "https://github.com/quonainejaz-official/smart-response/issues",
        "source": "https://github.com/quonainejaz-official/smart-response"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Quonain Ejaz",
            "email": "quonainejaz-official@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpstan/phpstan": "^1.10|^2.0"
    },
    "suggest": {
        "illuminate/contracts": "Required by the Laravel integration; Laravel installs this automatically.",
        "illuminate/http": "Required by the Laravel integration; Laravel installs this automatically.",
        "illuminate/support": "Required by the Laravel integration; Laravel installs this automatically.",
        "illuminate/view": "Required by the Laravel integration; Laravel installs this automatically.",
        "illuminate/pagination": "Required by the Laravel integration; Laravel installs this automatically.",
        "illuminate/translation": "Required by the Laravel integration; Laravel installs this automatically.",
        "cboden/ratchet": "Compatible WebSocket runtime for Runtime\\WebSocket\\WebSocketServer",
        "ext-soap": "Required for Runtime\\Soap\\SoapServerAdapter",
        "ext-grpc": "Optional PHP gRPC client support"
    },
    "autoload": {
        "psr-4": {
            "Quonain\\SmartResponse\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Quonain\\SmartResponse\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Quonain\\SmartResponse\\SmartResponseServiceProvider"
            ],
            "aliases": {
                "SmartResponse": "Quonain\\SmartResponse\\Facades\\SmartResponse"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "release": "php tools/release.php"
    }
}
